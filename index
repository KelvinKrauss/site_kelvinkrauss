<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelvin Krauss — Portfólio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Dark mode (default) */
      --bg: #0b1120;
      --surface: rgba(30, 41, 59, 0.55);
      --surface-solid: #161f32;
      --surface-light: #1e293b;
      --border: rgba(51, 65, 85, 0.7);
      --border-hover: #475569;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --heading: #f8fafc;
      --brand: #818cf8;
      --brand-gradient: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
      --nav-bg: rgba(11, 17, 32, 0.55);
      --panel-translucent: rgba(30, 41, 59, 0.5);
      --chat-panel-bg: rgba(17, 24, 39, 0.97);
      --modal-body-bg: #0b1120;

      --font-sans: 'Plus Jakarta Sans', sans-serif;
      --font-title: 'Space Grotesk', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      --shadow-sm: 0 2px 8px rgba(0,0,0,0.18);
      --shadow-md: 0 8px 24px rgba(0,0,0,0.24);
      --shadow-hover: 0 12px 32px rgba(0,0,0,0.32);
      --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);

      --dot-color: #334155;
      --dot-opacity: 0.35;
      --dot-glow-color: #818cf8;
    }

    :root[data-theme="light"] {
      --bg: #f8fafc;
      --surface: rgba(255, 255, 255, 0.85);
      --surface-solid: #ffffff;
      --surface-light: #f1f5f9;
      --border: rgba(226, 232, 240, 0.8);
      --border-hover: #cbd5e1;
      --text: #0f172a;
      --muted: #64748b;
      --heading: var(--heading);
      --brand: #4f46e5;
      --brand-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      --nav-bg: rgba(255, 255, 255, 0.55);
      --panel-translucent: rgba(255, 255, 255, 0.5);
      --chat-panel-bg: rgba(255, 255, 255, 0.97);
      --modal-body-bg: #f8fafc;

      --shadow-sm: 0 2px 8px rgba(15,23,42,0.04);
      --shadow-md: 0 8px 24px rgba(15,23,42,0.06);
      --shadow-hover: 0 12px 32px rgba(15,23,42,0.08);

      --dot-color: #94a3b8;
      --dot-opacity: 0.25;
      --dot-glow-color: #4f46e5;
    }

    :root, :root[data-theme="light"] { transition: background-color 0.3s ease; }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; font-size: 15px; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .dot-grid-base {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px);
      background-size: 28px 28px;
      opacity: var(--dot-opacity);
      transition: opacity 0.3s ease;
    }

    .dot-grid-glow {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image: radial-gradient(circle, var(--dot-glow-color) 1px, transparent 1px);
      background-size: 28px 28px;
      opacity: 0;
      -webkit-mask-image: radial-gradient(
        180px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px),
        black 0%,
        rgba(0,0,0,0.3) 50%,
        transparent 100%
      );
      mask-image: radial-gradient(
        180px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px),
        black 0%,
        rgba(0,0,0,0.3) 50%,
        transparent 100%
      );
      transition: opacity 0.4s ease;
    }
    .dot-grid-glow.active { opacity: 0.6; }

    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 40px;
      background: var(--nav-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .logo { font-family: var(--font-title); font-size: 1.15rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em;}
    .logo span { background: var(--brand-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .nav-links { display: flex; gap: 16px; list-style: none; }
    .nav-links a {
      color: var(--muted); text-decoration: none; font-size: 0.85rem; font-weight: 600;
      transition: color 0.2s; cursor: pointer; position: relative;
    }
    .nav-links a:hover { color: var(--brand); }
    .nav-right { display: flex; align-items: center; gap: 16px; }
    .lang-btn {
      background: var(--surface-solid); border: 1px solid var(--border); color: var(--text);
      padding: 6px 12px; font-family: var(--font-mono); font-size: 0.75rem; cursor: pointer;
      border-radius: 8px; transition: var(--transition-smooth); box-shadow: var(--shadow-sm);
    }
    .lang-btn:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .theme-btn {
      background: var(--surface-solid); border: 1px solid var(--border); color: var(--text);
      width: 34px; height: 34px; border-radius: 8px; cursor: pointer; font-size: 0.95rem;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition-smooth); box-shadow: var(--shadow-sm);
    }
    .theme-btn:hover { border-color: var(--brand); transform: translateY(-1px); box-shadow: var(--shadow-md); }

    .main-container {
      display: grid;
      grid-template-columns: 1fr 380px; 
      max-width: 1400px;
      width: 100%;
      margin: 90px auto 0;
      padding: 40px;
      gap: 80px; 
      flex: 1;
      position: relative;
      z-index: 1;
    }

    .content-side { position: relative; }

    /* ── MODERN CONTINUOUS SCROLL, COM REVEAL AO ROLAR ── */
    .content-side > section {
      padding: 120px 4px 60px;
      border-bottom: 1px solid var(--border);
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s cubic-bezier(0.4,0,0.2,1);
    }
    .content-side > section:first-of-type { padding-top: 20px; }
    .content-side > section:last-of-type { border-bottom: none; }
    .content-side > section.in-view { opacity: 1; transform: translateY(0); }

    .section-bubble { max-width: 760px; width: 100%; }

    .nav-links a { position: relative; }
    .nav-links a::after {
      content: ''; position: absolute; left: 0; bottom: -6px; width: 0; height: 2px;
      background: var(--brand-gradient); transition: width 0.25s ease;
    }
    .nav-links a.active { color: var(--brand); }
    .nav-links a.active::after { width: 100%; }

    section h2 {
      font-family: var(--font-title); font-size: 1.5rem; font-weight: 700;
      margin-bottom: 28px; display: flex; align-items: center; gap: 16px; letter-spacing: -0.02em;
      color: var(--heading);
    }
    section h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), transparent); }

    .hero-header { 
      display: flex; 
      align-items: center; 
      justify-content: flex-start;
      gap: 28px;
      margin-bottom: 24px; 
    }
    
    .hero-box h1 { font-family: var(--font-title); font-size: 2.6rem; font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; color: var(--heading); }
    .hero-box h1 span { background: var(--brand-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    
    .avatar-container {
      width: 130px; height: 130px; border-radius: 30px;
      border: 4px solid #fff; box-shadow: var(--shadow-md);
      overflow: hidden; background: var(--surface-light); flex-shrink: 0;
      transition: var(--transition-smooth);
    }
    .avatar-container:hover { transform: scale(1.02) rotate(2deg); box-shadow: var(--shadow-hover); }
    .avatar-img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; }
    
    .hero-desc { font-size: 1rem; color: var(--muted); line-height: 1.65; max-width: 680px; margin-bottom: 28px; }
    
    .btn-resume {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--surface-solid); border: 1px solid var(--border);
      color: var(--text); padding: 12px 20px; border-radius: 12px;
      font-size: 0.9rem; font-weight: 600; cursor: pointer;
      transition: var(--transition-smooth); box-shadow: var(--shadow-sm);
    }
    .btn-resume:hover { 
      border-color: var(--brand); color: var(--brand); 
      transform: translateY(-2px); box-shadow: 0 8px 20px rgba(79, 70, 229, 0.12); 
    }
    .btn-resume span { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); background: var(--surface-light); padding: 2px 6px; border-radius: 4px;}

    .grid-layout { display: flex; flex-direction: column; gap: 16px; }
    .card {
      background: var(--surface); backdrop-filter: blur(8px);
      border: 1px solid var(--border); padding: 24px; border-radius: 16px;
      box-shadow: var(--shadow-sm); transition: var(--transition-smooth);
    }
    .card:hover { transform: translateY(-4px); border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
    .card-meta { font-family: var(--font-mono); font-size: 0.7rem; color: var(--brand); font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
    .card-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: var(--heading); }
    .card-desc { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }

    .timeline-list { display: flex; flex-direction: column; gap: 16px; }
    .timeline-card {
      background: var(--surface); backdrop-filter: blur(8px);
      border: 1px solid var(--border); border-left: 4px solid var(--brand);
      padding: 20px 24px; border-radius: 0 16px 16px 0; box-shadow: var(--shadow-sm);
      transition: var(--transition-smooth);
    }
    .timeline-card:hover { transform: translateX(4px); box-shadow: var(--shadow-md); border-color: var(--border-hover); border-left-color: var(--brand); }
    .timeline-year { font-family: var(--font-mono); font-size: 0.7rem; color: var(--brand); margin-bottom: 6px; letter-spacing: 0.08em; font-weight: 600; }
    .timeline-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 4px; color: var(--heading);}
    .timeline-subtitle { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); font-weight: 500; margin-bottom: 10px;}
    .timeline-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.6; }

    .skills-container { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
    .skill-tag {
      background: var(--surface-solid); border: 1px solid var(--border);
      padding: 8px 14px; border-radius: 24px; font-size: 0.8rem;
      font-weight: 600; color: var(--text); transition: var(--transition-smooth);
      box-shadow: var(--shadow-sm);
    }
    .skill-tag:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .skills-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }

    .lang-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 16px; }
    .lang-card {
      background: var(--surface); border: 1px solid var(--border); padding: 20px; border-radius: 12px;
      box-shadow: var(--shadow-sm); transition: var(--transition-smooth);
    }
    .lang-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: var(--border-hover); }
    .lang-name { font-size: 1rem; font-weight: 700; margin-bottom: 4px; color: var(--heading); }
    .lang-level { font-family: var(--font-mono); font-size: 0.75rem; color: var(--brand); font-weight: 500; }

    .certs-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 16px; }
    .cert-item {
      background: var(--surface); border: 1px solid var(--border); padding: 16px; border-radius: 12px;
      display: flex; justify-content: space-between; align-items: center; cursor: pointer;
      box-shadow: var(--shadow-sm); transition: var(--transition-smooth);
    }
    .cert-item:hover { transform: translateY(-2px); border-color: var(--brand); background: var(--surface-solid); box-shadow: var(--shadow-md); }
    .cert-info h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; color: var(--heading); }
    .cert-info span { font-size: 0.75rem; color: var(--muted); font-family: var(--font-mono); }
    .cert-icon { color: var(--brand); font-size: 0.9rem; flex-shrink: 0; opacity: 0.5; transition: opacity 0.2s; }
    .cert-item:hover .cert-icon { opacity: 1; }
    
    .certs-toggle-btn {
      width: 100%; margin-top: 16px; background: var(--surface-solid); border: 1px dashed var(--border);
      border-radius: 12px; padding: 14px 20px; display: flex; align-items: center;
      justify-content: space-between; cursor: pointer; font-family: var(--font-mono);
      font-size: 0.75rem; color: var(--muted); transition: var(--transition-smooth); font-weight: 500;
    }
    .certs-toggle-btn:hover { color: var(--brand); border-color: var(--brand); background: var(--surface-light); }
    .certs-toggle-icon { transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .certs-toggle-btn.open .certs-toggle-icon { transform: rotate(180deg); }
    .certs-extra { max-height: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .certs-extra.open { max-height: 2000px; }
    .certs-extra-inner { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 16px; padding-top: 16px; }

    .contact-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 16px; }
    .contact-link {
      display: flex; align-items: center; gap: 14px; padding: 16px; background: var(--surface);
      border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--text);
      box-shadow: var(--shadow-sm); font-weight: 600; font-size: 0.9rem; transition: var(--transition-smooth);
    }
    .contact-link:hover { transform: translateY(-2px); background: var(--brand); color: white; border-color: var(--brand); box-shadow: var(--shadow-hover); }
    .contact-link span { font-size: 0.7rem; color: var(--muted); font-family: var(--font-mono); display: block; font-weight: 500; margin-bottom: 4px; text-transform: uppercase;}
    .contact-link:hover span { color: rgba(255,255,255,0.8); }

    /* ── CHAT SIDEBAR (desktop) ── */
    .chat-side {
      position: sticky; top: 110px;
      align-self: start;
      height: auto;
      max-height: calc(100vh - 150px);
      display: flex; flex-direction: column;
      background: var(--surface); backdrop-filter: blur(12px);
      border: 1px solid var(--border); border-radius: 20px;
      box-shadow: 0 16px 40px rgba(15,23,42,0.06); overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .chat-header {
      padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--panel-translucent);
      display: flex; align-items: center; gap: 12px;
      flex-shrink: 0;
    }
    .ai-dot { width: 10px; height: 10px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 10px rgba(34, 197, 94, 0.6); animation: pulse 2s infinite; flex-shrink: 0; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .chat-header-title { font-weight: 700; font-size: 0.95rem; flex: 1; color: var(--heading); }

    .chat-messages { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .chat-messages::-webkit-scrollbar { width: 6px; }
    .chat-messages::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; }

    /* Área de mensagens do sidebar (desktop): altura acompanha o conteúdo (encolhe
       com pouco texto, cresce com muito) mas nunca ultrapassa o espaço disponível,
       evitando que o cabeçalho/sugestões/input sejam cortados pelo overflow:hidden. */
    .chat-side .chat-messages {
      flex: 0 1 auto;
      min-height: 70px;
      max-height: clamp(120px, calc(100vh - 430px), 380px);
    }

    .msg { display: flex; max-width: 85%; }
    .msg.user { align-self: flex-end; }
    .msg-bubble { padding: 10px 14px; font-size: 0.85rem; line-height: 1.5; border-radius: 12px; box-shadow: var(--shadow-sm); }
    .msg.ai .msg-bubble { background: var(--surface-solid); border: 1px solid var(--border); color: var(--text); border-top-left-radius: 4px; }
    .msg.user .msg-bubble { background: var(--brand-gradient); color: #fff; border-top-right-radius: 4px; border: 1px solid transparent; }

    .typing-bar {
      display: none; padding: 6px 18px 10px;
      align-items: center; gap: 6px;
    }
    .typing-bar.active { display: flex; }
    .typing-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brand); animation: bounce 1.2s infinite; }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-4px)} }

    .suggestions { 
      display: grid; 
      grid-template-columns: 1fr 1fr; 
      gap: 10px; 
      padding: 16px 16px; 
      border-top: 1px solid var(--border);
    }
    .suggest-btn {
      background: var(--surface-solid); border: 1px solid var(--border); color: var(--text);
      padding: 10px; border-radius: 12px; font-size: 0.75rem; cursor: pointer; transition: var(--transition-smooth);
      font-weight: 600; text-align: center; display: flex; align-items: center; justify-content: center; line-height: 1.3;
    }
    .suggest-btn:hover { border-color: var(--brand); color: var(--brand); background: var(--surface-light); transform: translateY(-2px); box-shadow: var(--shadow-sm); }

    .chat-input-area { padding: 14px 18px 18px; display: flex; gap: 10px; border-top: 1px solid var(--border); background: var(--panel-translucent); }
    .chat-input {
      flex: 1; background: var(--surface-solid); border: 1px solid var(--border);
      color: var(--text); padding: 10px 14px; border-radius: 10px; outline: none; font-size: 0.85rem;
      font-family: var(--font-sans); transition: var(--transition-smooth); box-shadow: inset 0 2px 4px rgba(15,23,42,0.02);
    }
    .chat-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1); }
    .send-btn {
      background: var(--brand-gradient); color: #fff; border: none; padding: 0 18px;
      border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 0.85rem; transition: var(--transition-smooth);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
    }
    .send-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3); }
    .send-btn:disabled { background: var(--border); color: var(--muted); cursor: not-allowed; box-shadow: none; transform: none; }

    /* ── FAB (mobile) ── */
    .chat-fab {
      display: none;
      position: fixed;
      bottom: 28px;
      right: 24px;
      z-index: 200;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--brand-gradient);
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(79,70,229,0.35);
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      perspective: 400px;
    }
    .chat-fab:hover { box-shadow: 0 12px 32px rgba(79,70,229,0.45); }
    .chat-fab-icon { display: block; pointer-events: none; line-height: 1; }
    @keyframes coin-to-open {
      0%   { transform: rotateY(0deg); }
      49%  { transform: rotateY(90deg); opacity: 0; }
      50%  { transform: rotateY(-90deg); opacity: 0; }
      100% { transform: rotateY(0deg); opacity: 1; }
    }
    @keyframes coin-to-close {
      0%   { transform: rotateY(0deg); }
      49%  { transform: rotateY(-90deg); opacity: 0; }
      50%  { transform: rotateY(90deg); opacity: 0; }
      100% { transform: rotateY(0deg); opacity: 1; }
    }
    .chat-fab.flipping .chat-fab-icon { animation: coin-to-open 0.45s ease forwards; }
    .chat-fab.unflipping .chat-fab-icon { animation: coin-to-close 0.45s ease forwards; }

    /* Badge de mensagem não lida */
    .chat-fab-badge {
      position: absolute;
      top: 2px; right: 2px;
      width: 16px; height: 16px;
      background: #ef4444;
      border-radius: 50%;
      border: 2px solid #fff;
      display: none;
    }
    .chat-fab-badge.show { display: block; }

    /* Painel de chat flutuante (mobile) */
    .chat-float-panel {
      display: none;
      position: fixed;
      bottom: 100px;
      right: 16px;
      left: 16px;
      z-index: 199;
      height: 72vh;
      max-height: 560px;
      flex-direction: column;
      background: var(--chat-panel-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(15,23,42,0.18);
      overflow: hidden;
      transform: translateY(20px) scale(0.97);
      opacity: 0;
      transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease;
    }
    .chat-float-panel.open {
      transform: translateY(0) scale(1);
      opacity: 1;
    }

    /* Overlay escuro por trás do painel no mobile */
    .chat-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,0.3);
      backdrop-filter: blur(2px);
      z-index: 198;
    }
